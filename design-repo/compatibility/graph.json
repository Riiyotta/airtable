{
  "$description": "Rhythm/compatibility rules. Each rule is implemented in schema/semantic_validate.py under the same id and severity; extraction/verify_all.py fails if the two diverge.",
  "rules": [
    {
      "id": "TEMPLATE_NODE_SEQUENCE",
      "severity": "error",
      "description": "The PageSpec's nodes must match the node list of the template it declares (order for zone 'ordered', unordered body regions, required/repeatable, min/maxCount, allowed variants). Cross-references `template` -- never checks nodes in isolation."
    },
    {
      "id": "ROUTE_TEMPLATE_BINDING",
      "severity": "error",
      "description": "A real route (templates/routes.json) must use its bound template; a new route is only allowed on a template with acceptsNewRoutes=true and must match its newRoutePattern and not collide with another template's real route."
    },
    {
      "id": "HOME_ROUTE_ONLY",
      "severity": "error",
      "description": "template.home is only valid on '/', and '/' is only valid with template.home."
    },
    {
      "id": "SHELL_HEADER_FIRST",
      "severity": "error",
      "description": "shell.header is node 0 (Layout renders Header before <main> on every route).",
      "evidence": [
        {
          "ref": "src/layout/Layout.jsx:41",
          "anchor": "<Header />"
        }
      ]
    },
    {
      "id": "SHELL_FOOTER_LAST",
      "severity": "error",
      "description": "shell.footer is the last node (Layout renders Footer after <main>).",
      "evidence": [
        {
          "ref": "src/layout/Layout.jsx:46",
          "anchor": "<Footer variant={FOOTER_VARIANT[route]} />"
        }
      ]
    },
    {
      "id": "BREADCRUMB_FOLLOWS_HEADER",
      "severity": "error",
      "description": "A breadcrumb section (bk.breadcrumb / season.breadcrumb), when present, is node 1 directly under the header.",
      "evidence": [
        {
          "ref": "src/season/SeasonPage.jsx:49",
          "anchor": "{breadcrumb && <Breadcrumb {...breadcrumb} />}"
        }
      ]
    },
    {
      "id": "ONE_HERO_PER_PAGE",
      "severity": "error",
      "description": "At most one hero-category section (bk.guides-banner, bk.hero-carousel-centered, bk.hero-centered, bk.page-hero-split, pricing.title, season.hero, season.platform-hero). Exactly one is required except on the named hero-less templates.",
      "exceptions": {
        "heroLessTemplates": [
          "template.bk-contact-sales",
          "template.templates-gallery"
        ]
      },
      "evidence": [
        {
          "ref": "src/bk/pages/ContactSales.jsx:6",
          "anchor": "<ContactSalesSplit"
        }
      ]
    },
    {
      "id": "MAX_PER_PAGE",
      "severity": "error",
      "description": "Per-section count limits from each section contract's constraints (onePerPage -> 1, maxPerPage -> N), keyed on section id (variants of one section count together)."
    },
    {
      "id": "HOME_ONLY_SECTIONS",
      "severity": "error",
      "description": "Sections marked homeOnly (real homepage modules) are only valid on template.home."
    },
    {
      "id": "HOME_ASSET_ROLES_ONLY_ON_HOME",
      "severity": "error",
      "description": "Asset roles whose allowedOn is template.home (real Airtable/customer media) may only appear on template.home, and contentPolicy.realBrandAssets must be 'home-route-reference-only' exactly when they appear."
    },
    {
      "id": "NO_OUTBOUND_LINKS",
      "severity": "error",
      "description": "Every href is a local route ('/x', not '//x') or '#'/'#fragment'. Former external links are '#'.",
      "evidence": [
        {
          "ref": "src/components/Header.jsx:7",
          "anchor": "const W = ''"
        },
        {
          "ref": "src/components/Footer.jsx:4",
          "anchor": "const W = ''"
        },
        {
          "ref": "src/layout/Layout.jsx:22",
          "anchor": "// and swallow '#' placeholders (former external links) so they don't jump to top."
        }
      ]
    },
    {
      "id": "VERBATIM_REAL_COPY",
      "severity": "error",
      "description": "No copy string (or sentence of one) may equal a sentence of the real Airtable homepage copy (normalised SHA-256 denylist of every real sentence/string of >=5 words plus the real person name, in compatibility/real-copy-denylist.json; text not stored)."
    },
    {
      "id": "COPY_BUDGET_MAX_WORDS",
      "severity": "error",
      "description": "Every copy field's word count is <= its section contract copyBudgets[path].maxWords."
    },
    {
      "id": "MOTION_PATTERN_ALLOWED",
      "severity": "error",
      "description": "motion.pattern must be one the section contract allows for the node's variant. Media slots are static since 1.1.0 (the season.side-by-side video sweep was removed with the md- illustrations), so video media carries no motion pattern of its own."
    },
    {
      "id": "REDUCED_MOTION_FALLBACK_REQUIRED",
      "severity": "error",
      "description": "motion.reducedMotionFallback is present and equals the fallback pinned to the pattern in the section contract."
    },
    {
      "id": "MOTION_FALLBACK_GAP",
      "severity": "warn",
      "description": "The chosen motion pattern's reduced-motion fallback is 'not-implemented' in the clone (known gap)."
    },
    {
      "id": "NO_ADJACENT_SAME_SECTION",
      "severity": "warn",
      "description": "Two consecutive nodes of the same section id.",
      "exceptions": {
        "allowedRepeats": [
          "season.side-by-side",
          "bk.media-text-row",
          "season.cards"
        ]
      }
    },
    {
      "id": "SIDE_BY_SIDE_ALTERNATES",
      "severity": "warn",
      "description": "Consecutive season.side-by-side rows alternate left/right (bottom resets); consecutive bk.media-text-row rows alternate `reverse`.",
      "evidence": [
        {
          "ref": "src/bk/pages/Solutions.jsx:52",
          "anchor": "reverse={i % 2 === 1}"
        }
      ]
    },
    {
      "id": "LOGOS_DIRECTLY_AFTER_HERO",
      "severity": "warn",
      "description": "A logos-category section (bk.logo-marquee, bk.logo-strip, pricing.logo-strip, season.logos) sits directly after the hero.",
      "exceptions": {
        "templates": [
          "template.season-about",
          "template.pricing"
        ]
      }
    },
    {
      "id": "CTA_NEAR_END",
      "severity": "warn",
      "description": "A cta-category section (bk.cta-box, bk.cta-row, season.cta) is within the last 3 content nodes (before the footer)."
    },
    {
      "id": "MOTION_BUDGET",
      "severity": "warn",
      "description": "At most 3 continuous/timer motion patterns per page (max observed on a real route: /platform).",
      "exceptions": {
        "max": 3
      }
    },
    {
      "id": "BRAND_NAME_IN_COPY",
      "severity": "warn",
      "description": "Copy contains the word 'Airtable'. Generated pages should use neutral product wording (the clone itself has 3 such eyebrows on /platform and /solutions/enterprise)."
    }
  ],
